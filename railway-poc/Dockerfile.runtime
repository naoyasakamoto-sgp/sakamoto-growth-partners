FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-runtime.txt .
RUN pip install --no-cache-dir -r requirements-runtime.txt \
 && pip uninstall -y opencv-python opencv-contrib-python opencv-python-headless \
 && pip install --no-cache-dir opencv-python-headless==4.10.0.84
RUN python - <<'PY'
from paddleocr import PaddleOCR
PaddleOCR(use_angle_cls=False,lang='japan',show_log=False,use_gpu=False,cpu_threads=1,enable_mkldnn=False)
print('PaddleOCR runtime model cached')
PY
COPY runtime_app.py .
RUN python -m py_compile runtime_app.py
EXPOSE 8000
CMD ["python","runtime_app.py"]
